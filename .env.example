# Copy to .env on the server. Keep real values out of Git.
PUBLIC_ORIGIN=https://dh.kazerush.xyz
# Emergency server-side password fallback only (default false; never shown in the UI).
# Preserve the legacy owner name in AUTH_USERNAME on the first SQLite migration.
AUTH_PASSWORD_LOGIN=false
AUTH_USERNAME=
AUTH_PASSWORD=
# Generate each independently: openssl rand -hex 32
AUTH_SECRET=
# Shared only with the blog server; never put in VITE_* or NEXT_PUBLIC_*.
BLOG_NAVIGATION_TOKEN=
# Set these together after registering the OAuth client.
# BLOG_OAUTH_ISSUER=https://zxublog.com
# BLOG_OAUTH_INTERNAL_URL=http://xublog:3100
BLOG_OAUTH_ISSUER=
BLOG_OAUTH_INTERNAL_URL=
BLOG_OAUTH_CLIENT_ID=
BLOG_OAUTH_CLIENT_SECRET=
NAVI_PORT=8787
NAVI_NETWORK=navi-blog-link
# Optional origins for CORS reads. Writes use PUBLIC_ORIGIN.
ALLOWED_ORIGINS=
# Enable only behind a trusted proxy that overwrites X-Real-IP. For Docker, add
# the exact navi-blog-link gateway address, e.g. 172.20.0.1/32, after inspecting it.
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Bare Node start overrides (Docker sets these automatically).
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.local-data/navi.sqlite
