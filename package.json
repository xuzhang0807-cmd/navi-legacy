{
  "name": "navi-legacy-maintenance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:demo": "VITE_DEMO_MODE=true vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local --port 8787 --persist-to .wrangler-local",
    "db:migrate:local": "wrangler d1 migrations apply navigation-db --local --persist-to .wrangler-local",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wrangler": "^4.7.2"
  }
}
