# Copy to .env on the server. Keep real values out of Git.
PUBLIC_ORIGIN=https://dh.example.com
AUTH_ENABLED=true
AUTH_REQUIRED_FOR_READ=false
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-admin-password
# Generate each independently: openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Shared only with the blog server; never put in VITE_* or NEXT_PUBLIC_*.
BLOG_NAVIGATION_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
NAVI_PORT=8787
NAVI_NETWORK=navi-blog-link
# Optional explicit origins, comma separated; server-to-server blog requests need none.
ALLOWED_ORIGINS=
# Enable only behind a trusted proxy that overwrites X-Real-IP. For Docker, add
# the exact navi-blog-link gateway address, e.g. 172.20.0.1/32, after inspecting it.
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Bare Node start overrides (Docker sets these automatically).
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.local-data/navi.sqlite
